{
  "name": "floora-ar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @floora/api",
    "dev:web": "npm run dev --workspace @floora/web",
    "build": "npm run build --workspace @floora/web",
    "test": "npm run test --workspace @floora/api && npm run test --workspace @floora/web",
    "lint": "eslint apps --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
